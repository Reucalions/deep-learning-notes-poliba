\newlabel{sec:logsigmoid}{{4.8}{45}{LogSigmoid -- \texttt {nn.LogSigmoid()}}{section.4.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.22}{\ignorespaces LogSigmoid: logaritmo della Sigmoid. Progettata per gestire le instabilità numeriche che emergono quando funzioni con esponenziali vengono composte (overflow/underflow). Usata prevalentemente nelle funzioni di costo, non come attivazione interna.}}{45}{figure.4.22}\protected@file@percent }
\newlabel{fig:logsigmoid}{{4.22}{45}{LogSigmoid: logaritmo della Sigmoid. Progettata per gestire le instabilità numeriche che emergono quando funzioni con esponenziali vengono composte (overflow/underflow). Usata prevalentemente nelle funzioni di costo, non come attivazione interna}{figure.4.22}{}}
