\newlabel{fig:disentangling}{{3.10}{33}{L'ideal feature extractor mappa lo spazio dei pixel (sinistra) nel manifold dei volti (destra), dove le coordinate corrispondono a fattori interpretabili come ``view'' (punto di vista) e ``expression'' (espressione). Ogni punto blu nel manifold corrisponde a un'immagine specifica}{figure.3.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.11}{\ignorespaces Data manifold appreso [Hadsell et al., CVPR 2006]: le immagini di aeroplani in diverse orientazioni formano una struttura ciclica coerente nello spazio di embedding -- punti vicini corrispondono a immagini visivamente simili.}}{33}{figure.3.11}\protected@file@percent }
