\@writefile{lof}{\contentsline {figure}{\numberline {4.24}{\ignorespaces Softmax: trasforma uno score vettoriale in una distribuzione di probabilità sommante a $1$. Enfatizza il valore più grande: per $x=[1,2,3]$ produce $[0{,}090,\, 0{,}245,\, 0{,}665]$. Amplifica le differenze tra i valori (\emph  {winner-takes-all}).}}{47}{figure.4.24}\protected@file@percent }
\newlabel{fig:softmax}{{4.24}{47}{Softmax: trasforma uno score vettoriale in una distribuzione di probabilità sommante a $1$. Enfatizza il valore più grande: per $x=[1,2,3]$ produce $[0{,}090,\, 0{,}245,\, 0{,}665]$. Amplifica le differenze tra i valori (\emph {winner-takes-all})}{figure.4.24}{}}
\@writefile{toc}{\contentsline {paragraph}{Softmax come generalizzazione di Sigmoid.}{47}{section*.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.25}{\ignorespaces Derivazione della Sigmoid come caso speciale della Softmax a 2 classi. Questa relazione spiega perché la regressione logistica binaria (che usa Sigmoid) è un caso speciale della Softmax multiclasse.}}{47}{figure.4.25}\protected@file@percent }
\newlabel{fig:softmax_relation_sigmoid}{{4.25}{47}{Derivazione della Sigmoid come caso speciale della Softmax a 2 classi. Questa relazione spiega perché la regressione logistica binaria (che usa Sigmoid) è un caso speciale della Softmax multiclasse}{figure.4.25}{}}
