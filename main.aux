\@writefile{lof}{\contentsline {figure}{\numberline {4.25}{\ignorespaces Derivazione della Sigmoid come caso speciale della Softmax a 2 classi. Questa relazione spiega perché la regressione logistica binaria (che usa Sigmoid) è un caso speciale della Softmax multiclasse.}}{52}{figure.4.25}\protected@file@percent }
\newlabel{fig:softmax_relation_sigmoid}{{4.25}{52}{Derivazione della Sigmoid come caso speciale della Softmax a 2 classi. Questa relazione spiega perché la regressione logistica binaria (che usa Sigmoid) è un caso speciale della Softmax multiclasse}{figure.4.25}{}}
