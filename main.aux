\@writefile{lof}{\contentsline {figure}{\numberline {4.24}{\ignorespaces Softmax: trasforma uno score vettoriale in una distribuzione di probabilità sommante a $1$. Enfatizza il valore più grande: per $x=[1,2,3]$ produce $[0{,}090,\, 0{,}245,\, 0{,}665]$. Amplifica le differenze tra i valori (\emph  {winner-takes-all}).}}{52}{figure.4.24}\protected@file@percent }
\newlabel{fig:softmax}{{4.24}{52}{Softmax: trasforma uno score vettoriale in una distribuzione di probabilità sommante a $1$. Enfatizza il valore più grande: per $x=[1,2,3]$ produce $[0{,}090,\, 0{,}245,\, 0{,}665]$. Amplifica le differenze tra i valori (\emph {winner-takes-all})}{figure.4.24}{}}
