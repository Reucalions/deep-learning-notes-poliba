\@writefile{toc}{\contentsline {section}{\numberline {4.1}Il Problema del Vanishing Gradient}{36}{section.4.1}\protected@file@percent }
\newlabel{sec:vanishing-gradient}{{4.1}{36}{Il Problema del Vanishing Gradient}{section.4.1}{}}
\citation{bishop2024}
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Sigmoid e sua derivata. Il valore $\sigma (0)=0{,}5$ è il punto di inflessione e il gradiente massimo è $0{,}25$. Per input molto grandi o molto piccoli la derivata tende a zero, bloccando il flusso del gradiente nei layer profondi.}}{37}{figure.4.1}\protected@file@percent }
\newlabel{fig:vanishing_gradient}{{4.1}{37}{Sigmoid e sua derivata. Il valore $\sigma (0)=0{,}5$ è il punto di inflessione e il gradiente massimo è $0{,}25$. Per input molto grandi o molto piccoli la derivata tende a zero, bloccando il flusso del gradiente nei layer profondi}{figure.4.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.2}Panoramica: Saturating vs Non-Saturating}{37}{section.4.2}\protected@file@percent }
\newlabel{sec:overview-activations}{{4.2}{37}{Panoramica: Saturating vs Non-Saturating}{section.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Confronto visivo tra funzioni di attivazione saturanti e non saturanti (Sigmoid, ReLU, Leaky ReLU, ELU) nelle loro curve e nelle rispettive derivate. Le funzioni non saturanti mantengono un gradiente costante nella regione positiva, risolvendo il vanishing gradient.}}{37}{figure.4.2}\protected@file@percent }
\newlabel{fig:nonsaturating_overview}{{4.2}{37}{Confronto visivo tra funzioni di attivazione saturanti e non saturanti (Sigmoid, ReLU, Leaky ReLU, ELU) nelle loro curve e nelle rispettive derivate. Le funzioni non saturanti mantengono un gradiente costante nella regione positiva, risolvendo il vanishing gradient}{figure.4.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.3}Famiglia ReLU}{38}{section.4.3}\protected@file@percent }
\newlabel{sec:relu-family}{{4.3}{38}{Famiglia ReLU}{section.4.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.1}ReLU -- \texttt  {nn.ReLU()}}{38}{subsection.4.3.1}\protected@file@percent }
\newlabel{subsec:relu}{{4.3.1}{38}{ReLU -- \texttt {nn.ReLU()}}{subsection.4.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces ReLU: uscita identità per $x \geq 0$, zero per $x < 0$. La derivata è discontinua in $x=0$ ma il gradiente è $1$ per tutti gli input positivi, eliminando completamente il vanishing gradient nel ramo attivo.}}{38}{figure.4.3}\protected@file@percent }
\newlabel{fig:relu}{{4.3}{38}{ReLU: uscita identità per $x \geq 0$, zero per $x < 0$. La derivata è discontinua in $x=0$ ma il gradiente è $1$ per tutti gli input positivi, eliminando completamente il vanishing gradient nel ramo attivo}{figure.4.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Proprietà chiave.}{38}{section*.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.2}Leaky ReLU -- \texttt  {nn.LeakyReLU()}}{38}{subsection.4.3.2}\protected@file@percent }
\newlabel{subsec:leaky-relu}{{4.3.2}{38}{Leaky ReLU -- \texttt {nn.LeakyReLU()}}{subsection.4.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Leaky ReLU: introduce una piccola pendenza nella regione negativa ($a_{\text  {neg}}=0{,}1$ nella figura), consentendo al gradiente di fluire anche per neuroni con input negativo e risolvendo il \emph  {dead neuron} problem.}}{39}{figure.4.4}\protected@file@percent }
\newlabel{fig:leaky_relu}{{4.4}{39}{Leaky ReLU: introduce una piccola pendenza nella regione negativa ($a_{\text {neg}}=0{,}1$ nella figura), consentendo al gradiente di fluire anche per neuroni con input negativo e risolvendo il \emph {dead neuron} problem}{figure.4.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.3}PReLU -- \texttt  {nn.PReLU()}}{39}{subsection.4.3.3}\protected@file@percent }
\newlabel{subsec:prelu}{{4.3.3}{39}{PReLU -- \texttt {nn.PReLU()}}{subsection.4.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Parametric ReLU (PReLU): il coefficiente $a$ è un \textbf  {parametro apprendibile} con la retropropagazione. Chiamato senza argomenti, \texttt  {nn.PReLU()} usa un unico parametro $a$ condiviso; chiamato con \texttt  {nn.PReLU(C)}, usa un $a$ distinto per ognuno degli $C$ canali in input.}}{39}{figure.4.5}\protected@file@percent }
\newlabel{fig:prelu}{{4.5}{39}{Parametric ReLU (PReLU): il coefficiente $a$ è un \textbf {parametro apprendibile} con la retropropagazione. Chiamato senza argomenti, \texttt {nn.PReLU()} usa un unico parametro $a$ condiviso; chiamato con \texttt {nn.PReLU(C)}, usa un $a$ distinto per ognuno degli $C$ canali in input}{figure.4.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.4}RReLU -- \texttt  {nn.RReLU()}}{40}{subsection.4.3.4}\protected@file@percent }
\newlabel{subsec:rrelu}{{4.3.4}{40}{RReLU -- \texttt {nn.RReLU()}}{subsection.4.3.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Confronto visivo tra ReLU, Leaky ReLU/PReLU e Randomized Leaky ReLU (RReLU). In RReLU, il parametro $a_{ji}$ è campionato uniformemente da un intervallo $[l,u]$ durante il training; al test viene usato il valor medio $(l+u)/2$. Questo effetto di randomizzazione funge da regolarizzazione implicita.}}{40}{figure.4.6}\protected@file@percent }
\newlabel{fig:rrelu}{{4.6}{40}{Confronto visivo tra ReLU, Leaky ReLU/PReLU e Randomized Leaky ReLU (RReLU). In RReLU, il parametro $a_{ji}$ è campionato uniformemente da un intervallo $[l,u]$ durante il training; al test viene usato il valor medio $(l+u)/2$. Questo effetto di randomizzazione funge da regolarizzazione implicita}{figure.4.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Differenze nella regione negativa tra ELU, LReLU, ReLU e SReLU. LReLU usa una pendenza fissa piccola; PReLU la apprende; RReLU la randomizza durante il training e la fissa alla media al test.}}{40}{figure.4.7}\protected@file@percent }
\newlabel{fig:lrelu_prelu_rrelu_diff}{{4.7}{40}{Differenze nella regione negativa tra ELU, LReLU, ReLU e SReLU. LReLU usa una pendenza fissa piccola; PReLU la apprende; RReLU la randomizza durante il training e la fissa alla media al test}{figure.4.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.5}ReLU6 -- \texttt  {nn.ReLU6()}}{40}{subsection.4.3.5}\protected@file@percent }
\newlabel{subsec:relu6}{{4.3.5}{40}{ReLU6 -- \texttt {nn.ReLU6()}}{subsection.4.3.5}{}}
\citation{bishop2024}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces ReLU6: ReLU con saturazione superiore a $6$. Progettata per ambienti a precisione ridotta (es.\ mobile/quantizzazione), previene attivazioni molto grandi che possono degradare la rappresentazione in virgola mobile a bassa precisione.}}{41}{figure.4.8}\protected@file@percent }
\newlabel{fig:relu6}{{4.8}{41}{ReLU6: ReLU con saturazione superiore a $6$. Progettata per ambienti a precisione ridotta (es.\ mobile/quantizzazione), previene attivazioni molto grandi che possono degradare la rappresentazione in virgola mobile a bassa precisione}{figure.4.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.4}Famiglia ELU}{41}{section.4.4}\protected@file@percent }
\newlabel{sec:elu-family}{{4.4}{41}{Famiglia ELU}{section.4.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.1}ELU -- \texttt  {nn.ELU()}}{41}{subsection.4.4.1}\protected@file@percent }
\newlabel{subsec:elu}{{4.4.1}{41}{ELU -- \texttt {nn.ELU()}}{subsection.4.4.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces ELU: a differenza di ReLU, può produrre valori negativi, permettendo all'output medio del layer di essere vicino a zero. Questo centra le attivazioni e accelera la convergenza. Le varianti CELU e SELU sono reparametrizzazioni di ELU.}}{41}{figure.4.9}\protected@file@percent }
\newlabel{fig:elu}{{4.9}{41}{ELU: a differenza di ReLU, può produrre valori negativi, permettendo all'output medio del layer di essere vicino a zero. Questo centra le attivazioni e accelera la convergenza. Le varianti CELU e SELU sono reparametrizzazioni di ELU}{figure.4.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.2}CELU -- \texttt  {nn.CELU()}}{42}{subsection.4.4.2}\protected@file@percent }
\newlabel{subsec:celu}{{4.4.2}{42}{CELU -- \texttt {nn.CELU()}}{subsection.4.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.10}{\ignorespaces CELU (Continuously Differentiable ELU): reparametrizza ELU in modo da garantire la derivabilità continua in $x=0$ per qualsiasi valore di $\alpha $, migliorando la stabilità numerica del training.}}{42}{figure.4.10}\protected@file@percent }
\newlabel{fig:celu}{{4.10}{42}{CELU (Continuously Differentiable ELU): reparametrizza ELU in modo da garantire la derivabilità continua in $x=0$ per qualsiasi valore di $\alpha $, migliorando la stabilità numerica del training}{figure.4.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.3}SELU -- \texttt  {nn.SELU()}}{42}{subsection.4.4.3}\protected@file@percent }
\newlabel{subsec:selu}{{4.4.3}{42}{SELU -- \texttt {nn.SELU()}}{subsection.4.4.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.11}{\ignorespaces SELU (Scaled ELU): aggiunge un fattore di scala alla ELU. Con le costanti $\alpha $ e \emph  {scale} opportune, la SELU garantisce \emph  {self-normalizing} properties: attivazioni con media $0$ e varianza $1$ si propagano stabili attraverso layer arbitrariamente profondi, senza necessità di Batch Normalization.}}{42}{figure.4.11}\protected@file@percent }
\newlabel{fig:selu}{{4.11}{42}{SELU (Scaled ELU): aggiunge un fattore di scala alla ELU. Con le costanti $\alpha $ e \emph {scale} opportune, la SELU garantisce \emph {self-normalizing} properties: attivazioni con media $0$ e varianza $1$ si propagano stabili attraverso layer arbitrariamente profondi, senza necessità di Batch Normalization}{figure.4.11}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.5}Softplus e GELU}{43}{section.4.5}\protected@file@percent }
\newlabel{sec:softplus-gelu}{{4.5}{43}{Softplus e GELU}{section.4.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5.1}Softplus -- \texttt  {nn.Softplus()}}{43}{subsection.4.5.1}\protected@file@percent }
\newlabel{subsec:softplus}{{4.5.1}{43}{Softplus -- \texttt {nn.Softplus()}}{subsection.4.5.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.12}{\ignorespaces Softplus: approssimazione \textbf  {smooth} di ReLU, con derivata continua in tutto $\mathbb  {R}$. All'aumentare di $\beta $ converge a ReLU. Può essere usata per \emph  {vincolare l'output a essere sempre positivo}. Per stabilità numerica, l'implementazione torna alla funzione lineare quando $x \cdot \beta > \mathrm  {threshold}$.}}{43}{figure.4.12}\protected@file@percent }
\newlabel{fig:softplus}{{4.12}{43}{Softplus: approssimazione \textbf {smooth} di ReLU, con derivata continua in tutto $\mathbb {R}$. All'aumentare di $\beta $ converge a ReLU. Può essere usata per \emph {vincolare l'output a essere sempre positivo}. Per stabilità numerica, l'implementazione torna alla funzione lineare quando $x \cdot \beta > \mathrm {threshold}$}{figure.4.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5.2}GELU -- \texttt  {nn.GELU()}}{43}{subsection.4.5.2}\protected@file@percent }
\newlabel{subsec:gelu}{{4.5.2}{43}{GELU -- \texttt {nn.GELU()}}{subsection.4.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.13}{\ignorespaces GELU (Gaussian Error Linear Unit): funzione \textbf  {non monotona}, a differenza di ReLU e delle sue varianti. Nella regione $x < 0$ l'output decresce, poi risale, imitando il comportamento del dropout stocastico. È la funzione di attivazione predefinita nei Transformer (BERT, GPT) per le sue proprietà di regolarizzazione implicita.}}{44}{figure.4.13}\protected@file@percent }
\newlabel{fig:gelu}{{4.13}{44}{GELU (Gaussian Error Linear Unit): funzione \textbf {non monotona}, a differenza di ReLU e delle sue varianti. Nella regione $x < 0$ l'output decresce, poi risale, imitando il comportamento del dropout stocastico. È la funzione di attivazione predefinita nei Transformer (BERT, GPT) per le sue proprietà di regolarizzazione implicita}{figure.4.13}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.6}Funzioni Saturanti}{44}{section.4.6}\protected@file@percent }
\newlabel{sec:saturating}{{4.6}{44}{Funzioni Saturanti}{section.4.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6.1}Sigmoid -- \texttt  {nn.Sigmoid()}}{44}{subsection.4.6.1}\protected@file@percent }
\newlabel{subsec:sigmoid}{{4.6.1}{44}{Sigmoid -- \texttt {nn.Sigmoid()}}{subsection.4.6.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.14}{\ignorespaces Sigmoid: output in $(0,1)$, il che la rende ideale come gate (LSTM, GRU) o per output probabilistici di classificatori binari. Impilare molti layer sigmoid causa il vanishing gradient: il gradiente della sigmoid è prossimo a zero per $|x| \gg 0$, bloccando la retropropagazione. Per reti profonde si preferisce ReLU.}}{45}{figure.4.14}\protected@file@percent }
\newlabel{fig:sigmoid}{{4.14}{45}{Sigmoid: output in $(0,1)$, il che la rende ideale come gate (LSTM, GRU) o per output probabilistici di classificatori binari. Impilare molti layer sigmoid causa il vanishing gradient: il gradiente della sigmoid è prossimo a zero per $|x| \gg 0$, bloccando la retropropagazione. Per reti profonde si preferisce ReLU}{figure.4.14}{}}
\@writefile{toc}{\contentsline {paragraph}{Connessione con Softmax.}{45}{section*.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6.2}Tanh -- \texttt  {nn.Tanh()}}{45}{subsection.4.6.2}\protected@file@percent }
\newlabel{subsec:tanh}{{4.6.2}{45}{Tanh -- \texttt {nn.Tanh()}}{subsection.4.6.2}{}}
\citation{bishop2024}
\@writefile{lof}{\contentsline {figure}{\numberline {4.15}{\ignorespaces Tanh: versione centrata della Sigmoid con output in $(-1, 1)$. L'output ha media approssimativamente zero, accelerando la convergenza rispetto a Sigmoid (nota fondamentale: la convergenza è più rapida quando la media degli input è vicina a zero, come avviene nel Batch Normalization). Soffre comunque del vanishing gradient.}}{46}{figure.4.15}\protected@file@percent }
\newlabel{fig:tanh}{{4.15}{46}{Tanh: versione centrata della Sigmoid con output in $(-1, 1)$. L'output ha media approssimativamente zero, accelerando la convergenza rispetto a Sigmoid (nota fondamentale: la convergenza è più rapida quando la media degli input è vicina a zero, come avviene nel Batch Normalization). Soffre comunque del vanishing gradient}{figure.4.15}{}}
\@writefile{toc}{\contentsline {paragraph}{Relazione con Sigmoid.}{46}{section*.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6.3}Hardtanh -- \texttt  {nn.Hardtanh()}}{46}{subsection.4.6.3}\protected@file@percent }
\newlabel{subsec:hardtanh}{{4.6.3}{46}{Hardtanh -- \texttt {nn.Hardtanh()}}{subsection.4.6.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.16}{\ignorespaces Hardtanh: approssimazione lineare a tratti di Tanh. I valori di saturazione $[-1, 1]$ sono regolabili tramite \texttt  {min\_val} e \texttt  {max\_val}. Funziona sorprendentemente bene quando i pesi rimangono in un range di valori piccoli, ed è computazionalmente più leggera di Tanh.}}{47}{figure.4.16}\protected@file@percent }
\newlabel{fig:hardtanh}{{4.16}{47}{Hardtanh: approssimazione lineare a tratti di Tanh. I valori di saturazione $[-1, 1]$ sono regolabili tramite \texttt {min\_val} e \texttt {max\_val}. Funziona sorprendentemente bene quando i pesi rimangono in un range di valori piccoli, ed è computazionalmente più leggera di Tanh}{figure.4.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6.4}Softsign -- \texttt  {nn.Softsign()}}{47}{subsection.4.6.4}\protected@file@percent }
\newlabel{subsec:softsign}{{4.6.4}{47}{Softsign -- \texttt {nn.Softsign()}}{subsection.4.6.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.17}{\ignorespaces Softsign: alternativa a Tanh con saturazione più lenta (decadimento polinomiale anziché esponenziale). Le code più pesanti implicano gradienti meno soggetti al vanishing problem rispetto a Tanh, ma l'output rimane in $(-1,1)$.}}{47}{figure.4.17}\protected@file@percent }
\newlabel{fig:softsign}{{4.17}{47}{Softsign: alternativa a Tanh con saturazione più lenta (decadimento polinomiale anziché esponenziale). Le code più pesanti implicano gradienti meno soggetti al vanishing problem rispetto a Tanh, ma l'output rimane in $(-1,1)$}{figure.4.17}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.7}Funzioni Shrink e Threshold}{48}{section.4.7}\protected@file@percent }
\newlabel{sec:shrink-threshold}{{4.7}{48}{Funzioni Shrink e Threshold}{section.4.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.7.1}Threshold -- \texttt  {nn.Threshold()}}{48}{subsection.4.7.1}\protected@file@percent }
\newlabel{subsec:threshold}{{4.7.1}{48}{Threshold -- \texttt {nn.Threshold()}}{subsection.4.7.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.18}{\ignorespaces Threshold (neurone binario): il gradiente è zero nella regione subthreshold, rendendo impossibile la retropropagazione per quei neuroni. È la ragione storica per cui la backpropagation non venne adottata negli anni '60--'70, quando si usavano neuroni binari. Attualmente non è utilizzata in reti moderne.}}{48}{figure.4.18}\protected@file@percent }
\newlabel{fig:threshold}{{4.18}{48}{Threshold (neurone binario): il gradiente è zero nella regione subthreshold, rendendo impossibile la retropropagazione per quei neuroni. È la ragione storica per cui la backpropagation non venne adottata negli anni '60--'70, quando si usavano neuroni binari. Attualmente non è utilizzata in reti moderne}{figure.4.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.7.2}Tanhshrink -- \texttt  {nn.Tanhshrink()}}{48}{subsection.4.7.2}\protected@file@percent }
\newlabel{subsec:tanhshrink}{{4.7.2}{48}{Tanhshrink -- \texttt {nn.Tanhshrink()}}{subsection.4.7.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.19}{\ignorespaces Tanhshrink: sottrae $\tanh (x)$ dall'input, producendo una funzione quasi lineare (con una lieve curvatura centrale). Usata in contesti di sparse coding per promuovere rappresentazioni sparse.}}{48}{figure.4.19}\protected@file@percent }
\newlabel{fig:tanhshrink}{{4.19}{48}{Tanhshrink: sottrae $\tanh (x)$ dall'input, producendo una funzione quasi lineare (con una lieve curvatura centrale). Usata in contesti di sparse coding per promuovere rappresentazioni sparse}{figure.4.19}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.7.3}Softshrink -- \texttt  {nn.Softshrink()}}{49}{subsection.4.7.3}\protected@file@percent }
\newlabel{subsec:softshrink}{{4.7.3}{49}{Softshrink -- \texttt {nn.Softshrink()}}{subsection.4.7.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.20}{\ignorespaces Softshrink: riduce il valore assoluto di $x$ di $\lambda $ verso zero, forzando a zero gli input nell'intervallo $[-\lambda , \lambda ]$. Corrisponde a un passo del gradiente per la norma $L_1$ ed è uno step dell'algoritmo ISTA (\emph  {Iterative Shrinkage-Thresholding}). Non è comunemente usata come attivazione nelle reti standard.}}{49}{figure.4.20}\protected@file@percent }
\newlabel{fig:softshrink}{{4.20}{49}{Softshrink: riduce il valore assoluto di $x$ di $\lambda $ verso zero, forzando a zero gli input nell'intervallo $[-\lambda , \lambda ]$. Corrisponde a un passo del gradiente per la norma $L_1$ ed è uno step dell'algoritmo ISTA (\emph {Iterative Shrinkage-Thresholding}). Non è comunemente usata come attivazione nelle reti standard}{figure.4.20}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.7.4}Hardshrink -- \texttt  {nn.Hardshrink()}}{49}{subsection.4.7.4}\protected@file@percent }
\newlabel{subsec:hardshrink}{{4.7.4}{49}{Hardshrink -- \texttt {nn.Hardshrink()}}{subsection.4.7.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.21}{\ignorespaces Hardshrink: variante discontinua di Softshrink. La discontinuità in $x = \pm \lambda $ rende il gradiente non definito in quei punti, per cui \textbf  {è sconsigliato l'uso con backpropagation}. Utilizzata in alcuni algoritmi di sparse coding fuori dal contesto delle reti neurali gradient-based.}}{50}{figure.4.21}\protected@file@percent }
\newlabel{fig:hardshrink}{{4.21}{50}{Hardshrink: variante discontinua di Softshrink. La discontinuità in $x = \pm \lambda $ rende il gradiente non definito in quei punti, per cui \textbf {è sconsigliato l'uso con backpropagation}. Utilizzata in alcuni algoritmi di sparse coding fuori dal contesto delle reti neurali gradient-based}{figure.4.21}{}}
