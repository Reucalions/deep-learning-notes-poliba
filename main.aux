\newlabel{fig:vae_latent}{{11.8}{125}{Confronto tra spazio latente irregolare (sinistra, autoencoder senza regolarizzazione: punti vicini non simili, regioni vuote) e spazio latente regolare (destra, VAE: distribuzioni continue e sovrapposte, proprietà di continuità e completezza garantite)}{figure.11.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {11.4.7}Il Reparametrization Trick}{125}{subsection.11.4.7}\protected@file@percent }
\newlabel{subsec:reparam-trick}{{11.4.7}{125}{Il Reparametrization Trick}{subsection.11.4.7}{}}
\newlabel{eq:reparam}{{11.12}{125}{Il Reparametrization Trick}{equation.11.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11.9}{\ignorespaces Reparametrization trick. Sinistra: il campionamento diretto $\mathbf  {z} \sim \mathcal  {N}(\bm  {\mu }_\mathbf  {x}, \bm  {\sigma }_\mathbf  {x})$ blocca la backpropagation (linee tratteggiate). Destra: con il trick, $\bm  {\zeta } \sim \mathcal  {N}(\mathbf  {0},\mathbf  {I})$ è esterno al grafo, e la trasformazione $\mathbf  {z} = \bm  {\sigma }_\mathbf  {x}\bm  {\zeta } + \bm  {\mu }_\mathbf  {x}$ è differenziabile (linee continue).}}{126}{figure.11.9}\protected@file@percent }
\newlabel{fig:reparam}{{11.9}{126}{Reparametrization trick. Sinistra: il campionamento diretto $\mathbf {z} \sim \mathcal {N}(\boldsymbol {\mu }_\mathbf {x}, \boldsymbol {\sigma }_\mathbf {x})$ blocca la backpropagation (linee tratteggiate). Destra: con il trick, $\boldsymbol {\zeta } \sim \mathcal {N}(\mathbf {0},\mathbf {I})$ è esterno al grafo, e la trasformazione $\mathbf {z} = \boldsymbol {\sigma }_\mathbf {x}\boldsymbol {\zeta } + \boldsymbol {\mu }_\mathbf {x}$ è differenziabile (linee continue)}{figure.11.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {11.4.8}Schema Completo del VAE}{126}{subsection.11.4.8}\protected@file@percent }
\newlabel{subsec:vae-complete}{{11.4.8}{126}{Schema Completo del VAE}{subsection.11.4.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11.10}{\ignorespaces Schema completo del VAE con reparametrization trick. L'encoder produce $\bm  {\mu }_\mathbf  {x} = g(\mathbf  {x})$ e $\bm  {\sigma }_\mathbf  {x} = h(\mathbf  {x})$; il campionamento è realizzato tramite $\mathbf  {z} = \bm  {\sigma }_\mathbf  {x} \bm  {\zeta } + \bm  {\mu }_\mathbf  {x}$ con $\bm  {\zeta } \sim \mathcal  {N}(\mathbf  {0},\mathbf  {I})$; il decoder restituisce $\hat  {\mathbf  {x}} = f(\mathbf  {z})$. La loss è la somma di errore di ricostruzione e KL-divergenza.}}{126}{figure.11.10}\protected@file@percent }
\newlabel{fig:vae_full}{{11.10}{126}{Schema completo del VAE con reparametrization trick. L'encoder produce $\boldsymbol {\mu }_\mathbf {x} = g(\mathbf {x})$ e $\boldsymbol {\sigma }_\mathbf {x} = h(\mathbf {x})$; il campionamento è realizzato tramite $\mathbf {z} = \boldsymbol {\sigma }_\mathbf {x} \boldsymbol {\zeta } + \boldsymbol {\mu }_\mathbf {x}$ con $\boldsymbol {\zeta } \sim \mathcal {N}(\mathbf {0},\mathbf {I})$; il decoder restituisce $\hat {\mathbf {x}} = f(\mathbf {z})$. La loss è la somma di errore di ricostruzione e KL-divergenza}{figure.11.10}{}}
\newlabel{lst:vae-pytorch}{{11.3}{126}{VAE: encoder, reparametrization e loss in PyTorch}{lstlisting.11.3}{}}
