\@writefile{lof}{\contentsline {figure}{\numberline {15.6}{\ignorespaces Layer di Graph Convolutional con message passing. Il grafo al layer $N$ ha attributi $(U_n, V_n, E_n)$; la funzione di pooling $\rho _{V_n \to V_i}$ aggrega i vicini di ciascun nodo; la funzione di aggiornamento $f_{V_n}$ (MLP) produce i nuovi embedding $V_{n+1}$. Lo stesso avviene per $U$ e $E$.}}{173}{figure.15.6}\protected@file@percent }
\newlabel{fig:message_passing}{{15.6}{173}{Layer di Graph Convolutional con message passing. Il grafo al layer $N$ ha attributi $(U_n, V_n, E_n)$; la funzione di pooling $\rho _{V_n \to V_i}$ aggrega i vicini di ciascun nodo; la funzione di aggiornamento $f_{V_n}$ (MLP) produce i nuovi embedding $V_{n+1}$. Lo stesso avviene per $U$ e $E$}{figure.15.6}{}}
