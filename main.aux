\@writefile{lof}{\contentsline {figure}{\numberline {18.6}{\ignorespaces Schema completo della Multi-Head Latent Attention (MLA). Il vettore di input $\mathbf  {h}_t$ viene proiettato in due vettori latenti $\mathbf  {c}_t^Q$ e $\mathbf  {c}_t^{KV}$ (dimensione ridotta). Solo $\mathbf  {c}_t^{KV}$ viene memorizzato in cache. Le query, le key e i value vengono ricostruiti tramite up-projection prima del calcolo dell'attenzione. Le chiavi RoPE sono calcolate separatamente e concatenate (decoupled RoPE).}}{217}{figure.18.6}\protected@file@percent }
\newlabel{fig:mla-architecture}{{18.6}{217}{Schema completo della Multi-Head Latent Attention (MLA). Il vettore di input $\mathbf {h}_t$ viene proiettato in due vettori latenti $\mathbf {c}_t^Q$ e $\mathbf {c}_t^{KV}$ (dimensione ridotta). Solo $\mathbf {c}_t^{KV}$ viene memorizzato in cache. Le query, le key e i value vengono ricostruiti tramite up-projection prima del calcolo dell'attenzione. Le chiavi RoPE sono calcolate separatamente e concatenate (decoupled RoPE)}{figure.18.6}{}}
